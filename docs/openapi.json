    "/applications/{app_id}/resume": {
      "post": {
        "tags": [
          "applications"
        ],
        "summary": "Resume Application",
        "description": "Answer the pending review (approve / edit / reject); the run continues in the background.\n\n409 if the application is not paused at a gate; 422 if the decision does not fit it.",
