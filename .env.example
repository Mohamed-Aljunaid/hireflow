# Copy to .env and fill in. Never commit .env.

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Effort for judgement-heavy steps (fit analysis).
ANTHROPIC_ANALYSIS_EFFORT=high
ANTHROPIC_MAX_TOKENS=16000
# Server-side refusal fallback (beta): retry declined requests on a fallback model.
ANTHROPIC_REFUSAL_FALLBACK=true

# --- Database ---
POSTGRES_USER=hireflow
POSTGRES_PASSWORD=hireflow
POSTGRES_DB=hireflow
# Used when running the API outside Docker (compose overrides it).
DATABASE_URL=postgresql+asyncpg://hireflow:hireflow@localhost:5432/hireflow
# Optional: enables the Postgres integration test.
# TEST_DATABASE_URL=postgresql+asyncpg://hireflow:hireflow@localhost:5432/hireflow_test

# --- App ---
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=5242880
